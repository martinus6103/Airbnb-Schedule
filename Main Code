import React, { useState, useEffect, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from 'firebase/auth';
import { getFirestore, collection, onSnapshot, doc, setDoc, deleteDoc, addDoc, query, where } from 'firebase/firestore';
import { 
  Calendar, Plus, Home, Users, Bed, Info, ChevronLeft, ChevronRight, 
  MapPin, Loader2, Settings, X, Save, AlertCircle, Trash2
} from 'lucide-react';

// --- Firebase Setup ---
const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
const app = Object.keys(firebaseConfig).length > 0 ? initializeApp(firebaseConfig) : { name: 'mock' };
const auth = app.name !== 'mock' ? getAuth(app) : null;
const db = app.name !== 'mock' ? getFirestore(app) : null;
const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-rental-app';

// --- Utilities ---
const parseICalDate = (dateStr) => {
  // Matches YYYYMMDD or YYYYMMDDTHHMMSSZ
  const match = dateStr.match(/^(\d{4})(\d{2})(\d{2})/);
  if (match) {
    return new Date(parseInt(match[1]), parseInt(match[2]) - 1, parseInt(match[3]));
  }
  return new Date();
};

const isSameDay = (d1, d2) => {
  return d1.getFullYear() === d2.getFullYear() && 
         d1.getMonth() === d2.getMonth() && 
         d1.getDate() === d2.getDate();
};

const getCalendarDays = (currentDate) => {
  const start = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);
  const end = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0);
  const days = [];
  
  // Pad start (Previous month days)
  const startDay = start.getDay();
  for (let i = startDay; i > 0; i--) {
    days.push({ date: new Date(start.getFullYear(), start.getMonth(), 1 - i), isCurrentMonth: false });
  }
  
  // Current month days
  for (let i = 1; i <= end.getDate(); i++) {
    days.push({ date: new Date(start.getFullYear(), start.getMonth(), i), isCurrentMonth: true });
  }
  
  // Pad end (Next month days)
  const endDay = end.getDay();
  for (let i = 1; i < 7 - endDay; i++) {
    days.push({ date: new Date(end.getFullYear(), end.getMonth() + 1, i), isCurrentMonth: false });
  }
  
  return days;
};

// --- Main Application ---
export default function App() {
  const [user, setUser] = useState(null);
  const [listings, setListings] = useState([]);
  const [selectedListingId, setSelectedListingId] = useState(null);
  
  // Data States
  const [manualBookings, setManualBookings] = useState([]);
  const [icalEvents, setIcalEvents] = useState([]);
  const [loadingIcal, setLoadingIcal] = useState(false);
  const [icalError, setIcalError] = useState(null);

  // Calendar State
  const [currentMonth, setCurrentMonth] = useState(new Date());

  // Modals State
  const [showListingModal, setShowListingModal] = useState(false);
  const [showBookingModal, setShowBookingModal] = useState(false);
  const [selectedBooking, setSelectedBooking] = useState(null);

  // Forms
  const [listingForm, setListingForm] = useState({ name: '', airbnbUrl: '', bookingUrl: '' });
  const [bookingForm, setBookingForm] = useState({ 
    platform: 'Direct', guestName: '', start: '', end: '', guests: 1, extraBed: false 
  });

  // 1. Initialize Auth
  useEffect(() => {
    if (!auth) return;
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Auth error:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  // 2. Fetch Listings
  useEffect(() => {
    if (!user || !db) return;
    const listingsRef = collection(db, 'artifacts', appId, 'public', 'data', 'listings');
    const unsub = onSnapshot(listingsRef, (snapshot) => {
      const fetchedListings = [];
      snapshot.forEach(doc => fetchedListings.push({ id: doc.id, ...doc.data() }));
      setListings(fetchedListings);
      
      // Auto-select first listing if none selected
      if (fetchedListings.length > 0 && !selectedListingId) {
        setSelectedListingId(fetchedListings[0].id);
      }
    });
    return () => unsub();
  }, [user]);

  // 3. Fetch Manual Bookings for Selected Listing
  useEffect(() => {
    if (!user || !db || !selectedListingId) return;
    const bookingsRef = collection(db, 'artifacts', appId, 'public', 'data', 'manualBookings');
    const q = query(bookingsRef, where('listingId', '==', selectedListingId));
    
    const unsub = onSnapshot(q, (snapshot) => {
      const fetched = [];
      snapshot.forEach(doc => {
        const data = doc.data();
        fetched.push({
          id: doc.id,
          uid: doc.id,
          platform: data.platform,
          summary: data.guestName,
          start: new Date(data.start),
          end: new Date(data.end),
          guests: data.guests,
          extraBed: data.extraBed,
          isManual: true
        });
      });
      setManualBookings(fetched);
    });
    return () => unsub();
  }, [user, selectedListingId]);

  // 4. Fetch iCal Feeds for Selected Listing
  useEffect(() => {
    if (!selectedListingId) return;
    const listing = listings.find(l => l.id === selectedListingId);
    if (!listing) return;

    const fetchIcal = async () => {
      setLoadingIcal(true);
      setIcalError(null);
      let allParsedEvents = [];

      const feedsToFetch = [
        { platform: 'Airbnb', url: listing.airbnbUrl },
        { platform: 'Booking.com', url: listing.bookingUrl }
      ].filter(f => f.url && f.url.trim() !== '');

      try {
        for (const feed of feedsToFetch) {
          // Use allorigins as a reliable public CORS proxy for text
          const proxyUrl = `https://api.allorigins.win/raw?url=${encodeURIComponent(feed.url)}`;
          const response = await fetch(proxyUrl);
          if (!response.ok) throw new Error(`Failed to fetch ${feed.platform}`);
          
          const text = await response.text();
          const unfolded = text.replace(/\r\n\s/g, '').replace(/\n\s/g, '');
          const lines = unfolded.split(/\r\n|\n|\r/);
          
          let currentEvent = null;
          
          for (let line of lines) {
            if (line === 'BEGIN:VEVENT') {
              currentEvent = { platform: feed.platform, isManual: false, extraBed: false, guests: '?' };
            } else if (line === 'END:VEVENT') {
              if (currentEvent && currentEvent.start && currentEvent.end) {
                const summary = (currentEvent.summary || '').toLowerCase();
                const isBlocked = summary.includes('not available') || summary.includes('blocked');
                
                // Clean up summaries
                if (currentEvent.platform === 'Airbnb' && currentEvent.summary?.startsWith('Reserved - ')) {
                  currentEvent.summary = currentEvent.summary.replace('Reserved - ', '');
                }
                
                if (!isBlocked) {
                  allParsedEvents.push(currentEvent);
                }
              }
              currentEvent = null;
            } else if (currentEvent) {
              if (line.startsWith('DTSTART')) currentEvent.start = parseICalDate(line.split(':')[1]);
              else if (line.startsWith('DTEND')) currentEvent.end = parseICalDate(line.split(':')[1]);
              else if (line.startsWith('SUMMARY')) currentEvent.summary = line.substring(line.indexOf(':') + 1);
              else if (line.startsWith('UID')) currentEvent.uid = line.substring(line.indexOf(':') + 1);
            }
          }
        }
        setIcalEvents(allParsedEvents);
      } catch (err) {
        console.error("iCal Fetch Error:", err);
        setIcalError("Failed to sync calendars. Showing available cached data.");
      } finally {
        setLoadingIcal(false);
      }
    };

    fetchIcal();
  }, [selectedListingId, listings]);

  // Combine and process bookings
  const allBookings = useMemo(() => {
    return [...icalEvents, ...manualBookings].sort((a, b) => a.start - b.start);
  }, [icalEvents, manualBookings]);

  // --- Handlers ---
  const handleSaveListing = async (e) => {
    e.preventDefault();
    if (!user || !db) return;
    try {
      const ref = collection(db, 'artifacts', appId, 'public', 'data', 'listings');
      await addDoc(ref, {
        name: listingForm.name,
        airbnbUrl: listingForm.airbnbUrl,
        bookingUrl: listingForm.bookingUrl,
        createdAt: Date.now()
      });
      setShowListingModal(false);
      setListingForm({ name: '', airbnbUrl: '', bookingUrl: '' });
    } catch (err) {
      console.error(err);
    }
  };

  const handleSaveBooking = async (e) => {
    e.preventDefault();
    if (!user || !db || !selectedListingId) return;
    try {
      const ref = collection(db, 'artifacts', appId, 'public', 'data', 'manualBookings');
      await addDoc(ref, {
        listingId: selectedListingId,
        platform: bookingForm.platform,
        guestName: bookingForm.guestName,
        start: bookingForm.start,
        end: bookingForm.end,
        guests: parseInt(bookingForm.guests) || 1,
        extraBed: bookingForm.extraBed,
        createdAt: Date.now()
      });
      setShowBookingModal(false);
      setBookingForm({ platform: 'Direct', guestName: '', start: '', end: '', guests: 1, extraBed: false });
    } catch (err) {
      console.error(err);
    }
  };

  const handleDeleteManualBooking = async (id) => {
    if (!user || !db) return;
    try {
      await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'manualBookings', id));
      setSelectedBooking(null);
    } catch (err) {
      console.error(err);
    }
  };

  // --- Rendering Helpers ---
  const getPlatformColors = (platform) => {
    if (platform === 'Airbnb') return 'bg-[#FF5A5F] text-white'; // Airbnb Pink/Red
    if (platform === 'Booking.com') return 'bg-[#003580] text-white'; // Booking Blue
    return 'bg-emerald-600 text-white'; // Direct/Manual Green
  };

  const prevMonth = () => setCurrentMonth(new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1));
  const nextMonth = () => setCurrentMonth(new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1));

  const calendarDays = getCalendarDays(currentMonth);

  return (
    <div className="flex h-screen bg-white text-slate-800 font-sans overflow-hidden">
      
      {/* LEFT SIDEBAR - Listings */}
      <div className="w-20 md:w-64 border-r border-slate-200 flex flex-col bg-slate-50 flex-shrink-0">
        <div className="p-4 border-b border-slate-200 flex items-center justify-between">
          <div className="flex items-center space-x-2 text-[#FF5A5F]">
            <Home className="w-6 h-6" />
            <span className="font-bold text-lg hidden md:block">Properties</span>
          </div>
        </div>
        
        <div className="flex-1 overflow-y-auto p-3 space-y-2">
          {listings.map(listing => (
            <button
              key={listing.id}
              onClick={() => setSelectedListingId(listing.id)}
              className={`w-full flex items-center space-x-3 p-2 rounded-xl transition-all ${
                selectedListingId === listing.id 
                  ? 'bg-white shadow-sm ring-1 ring-slate-200' 
                  : 'hover:bg-slate-100 opacity-70'
              }`}
            >
              <div className={`w-12 h-12 rounded-lg flex items-center justify-center flex-shrink-0 ${
                selectedListingId === listing.id ? 'bg-indigo-100 text-indigo-600' : 'bg-slate-200 text-slate-500'
              }`}>
                <MapPin className="w-6 h-6" />
              </div>
              <div className="hidden md:block text-left truncate">
                <p className="font-semibold text-sm truncate">{listing.name}</p>
                <p className="text-xs text-slate-500">Calendar view</p>
              </div>
            </button>
          ))}

          <button 
            onClick={() => setShowListingModal(true)}
            className="w-full flex items-center space-x-3 p-2 rounded-xl border border-dashed border-slate-300 text-slate-500 hover:bg-slate-100 transition-colors mt-4"
          >
            <div className="w-12 h-12 rounded-lg flex items-center justify-center bg-slate-50 flex-shrink-0">
              <Plus className="w-5 h-5" />
            </div>
            <span className="hidden md:block text-sm font-medium">Add Listing</span>
          </button>
        </div>

        <div className="p-4 border-t border-slate-200">
          <button 
            onClick={() => setShowListingModal(true)}
            className="flex items-center text-sm text-slate-600 hover:text-slate-900 w-full justify-center md:justify-start"
          >
            <Settings className="w-5 h-5 md:mr-2" />
            <span className="hidden md:block">Manage Feeds</span>
          </button>
        </div>
      </div>

      {/* MAIN CONTENT - Calendar Grid */}
      <div className="flex-1 flex flex-col min-w-0 bg-white">
        
        {/* Top Header */}
        <header className="h-16 border-b border-slate-200 px-6 flex items-center justify-between flex-shrink-0">
          <div className="flex items-center space-x-4">
            <h2 className="text-2xl font-bold">
              {currentMonth.toLocaleString('default', { month: 'long', year: 'numeric' })}
            </h2>
            <div className="flex space-x-1">
              <button onClick={prevMonth} className="p-1.5 rounded-full hover:bg-slate-100"><ChevronLeft className="w-5 h-5" /></button>
              <button onClick={nextMonth} className="p-1.5 rounded-full hover:bg-slate-100"><ChevronRight className="w-5 h-5" /></button>
            </div>
          </div>

          <div className="flex items-center space-x-4">
            {loadingIcal && (
              <span className="flex items-center text-sm text-slate-500 bg-slate-50 px-3 py-1 rounded-full border border-slate-200">
                <Loader2 className="w-4 h-4 animate-spin mr-2" /> Syncing...
              </span>
            )}
            <button 
              onClick={() => setShowBookingModal(true)}
              disabled={!selectedListingId}
              className="flex items-center px-4 py-2 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-slate-800 disabled:opacity-50 transition-colors"
            >
              <Plus className="w-4 h-4 mr-1.5" /> Add Booking
            </button>
          </div>
        </header>

        {icalError && (
          <div className="bg-red-50 text-red-600 p-2 text-sm text-center border-b border-red-100 flex justify-center items-center">
            <AlertCircle className="w-4 h-4 mr-2" /> {icalError}
          </div>
        )}

        {/* Calendar Grid Container */}
        <div className="flex-1 flex flex-col overflow-auto bg-slate-50 p-6">
          {!selectedListingId ? (
            <div className="flex-1 flex flex-col items-center justify-center text-slate-400">
              <Calendar className="w-16 h-16 mb-4 opacity-50" />
              <p className="text-lg font-medium text-slate-600">No listing selected</p>
              <p>Select or create a property on the left to view calendar.</p>
            </div>
          ) : (
            <div className="flex-1 bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col min-w-[600px]">
              {/* Days of Week */}
              <div className="grid grid-cols-7 border-b border-slate-200 flex-shrink-0">
                {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map(day => (
                  <div key={day} className="p-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    {day}
                  </div>
                ))}
              </div>
              
              {/* Days Grid */}
              <div className="grid grid-cols-7 flex-1 auto-rows-fr">
                {calendarDays.map((dayObj, i) => {
                  // Find bookings that overlap with this date
                  // A booking is active if date is >= start and date < end
                  const dayStart = new Date(dayObj.date.getFullYear(), dayObj.date.getMonth(), dayObj.date.getDate());
                  
                  const daysBookings = allBookings.filter(b => {
                    const bStart = new Date(b.start.getFullYear(), b.start.getMonth(), b.start.getDate());
                    const bEnd = new Date(b.end.getFullYear(), b.end.getMonth(), b.end.getDate());
                    return dayStart >= bStart && dayStart < bEnd;
                  });

                  return (
                    <div 
                      key={i} 
                      className={`min-h-[100px] border-b border-r border-slate-100 p-1.5 relative group
                        ${!dayObj.isCurrentMonth ? 'bg-slate-50 text-slate-400' : 'bg-white'}
                        ${i % 7 === 6 ? 'border-r-0' : ''}
                      `}
                    >
                      <span className={`inline-flex w-7 h-7 items-center justify-center rounded-full text-sm font-medium mb-1
                        ${isSameDay(dayObj.date, new Date()) ? 'bg-indigo-600 text-white' : ''}
                      `}>
                        {dayObj.date.getDate()}
                      </span>
                      
                      {/* Render Booking Pills */}
                      <div className="space-y-1 mt-1">
                        {daysBookings.map((b, idx) => {
                          const bStart = new Date(b.start.getFullYear(), b.start.getMonth(), b.start.getDate());
                          const bEnd = new Date(b.end.getFullYear(), b.end.getMonth(), b.end.getDate());
                          
                          // Determine border radius to make it look connected
                          const isStartDay = isSameDay(dayStart, bStart);
                          const isBeforeEndDay = isSameDay(dayStart, new Date(bEnd.getTime() - 86400000));
                          
                          let roundedClass = 'rounded-none';
                          if (isStartDay && isBeforeEndDay) roundedClass = 'rounded-md mx-1';
                          else if (isStartDay) roundedClass = 'rounded-l-md ml-1';
                          else if (isBeforeEndDay) roundedClass = 'rounded-r-md mr-1';
                          else roundedClass = 'w-full';

                          return (
                            <div 
                              key={`${b.uid}-${idx}`}
                              onClick={() => setSelectedBooking(b)}
                              className={`
                                cursor-pointer px-2 py-1 text-[11px] leading-tight font-semibold truncate shadow-sm transition-opacity hover:opacity-90
                                ${getPlatformColors(b.platform)}
                                ${roundedClass}
                              `}
                              title={b.summary}
                            >
                              {b.summary || 'Booked'}
                            </div>
                          )
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </div>
      </div>

      {/* --- MODALS --- */}

      {/* Booking Details Modal */}
      {selectedBooking && (
        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div className={`p-4 text-white flex justify-between items-start ${getPlatformColors(selectedBooking.platform).split(' ')[0]}`}>
              <div>
                <h3 className="text-xl font-bold mb-1">{selectedBooking.summary || 'Guest Booking'}</h3>
                <span className="inline-block bg-white/20 px-2 py-1 rounded text-xs font-semibold uppercase tracking-wider">
                  {selectedBooking.platform}
                </span>
              </div>
              <button onClick={() => setSelectedBooking(null)} className="text-white/70 hover:text-white"><X className="w-6 h-6" /></button>
            </div>
            
            <div className="p-6 space-y-4">
              <div className="grid grid-cols-2 gap-4">
                <div className="bg-slate-50 p-3 rounded-xl border border-slate-100">
                  <p className="text-xs text-slate-500 font-semibold uppercase">Check-in</p>
                  <p className="font-bold text-slate-800">{selectedBooking.start.toLocaleDateString()}</p>
                </div>
                <div className="bg-slate-50 p-3 rounded-xl border border-slate-100">
                  <p className="text-xs text-slate-500 font-semibold uppercase">Check-out</p>
                  <p className="font-bold text-slate-800">{selectedBooking.end.toLocaleDateString()}</p>
                </div>
              </div>
              
              <div className="flex items-center justify-between border-t border-slate-100 pt-4">
                <div className="flex items-center text-slate-700">
                  <Users className="w-5 h-5 mr-2 text-slate-400" />
                  <span className="font-medium">{selectedBooking.guests || '?'} Guests</span>
                </div>
                {selectedBooking.extraBed && (
                  <div className="flex items-center text-amber-600 bg-amber-50 px-3 py-1 rounded-full text-sm font-medium">
                    <Bed className="w-4 h-4 mr-1.5" /> Extra Bed Needed
                  </div>
                )}
              </div>

              {!selectedBooking.isManual && (
                <div className="flex items-start text-sm text-slate-500 bg-blue-50 p-3 rounded-lg border border-blue-100">
                  <Info className="w-4 h-4 mr-2 flex-shrink-0 mt-0.5 text-blue-500" />
                  <p>This booking is synced automatically via iCal. To edit guests or extra beds, update it on {selectedBooking.platform}.</p>
                </div>
              )}

              {selectedBooking.isManual && (
                <div className="pt-4 border-t border-slate-100">
                  <button 
                    onClick={() => handleDeleteManualBooking(selectedBooking.id)}
                    className="w-full flex justify-center items-center py-2 text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition-colors text-sm font-bold"
                  >
                    <Trash2 className="w-4 h-4 mr-2" /> Delete Manual Booking
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {/* Add Listing Modal */}
      {showListingModal && (
        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden">
            <div className="p-4 border-b border-slate-200 flex justify-between items-center">
              <h3 className="font-bold text-lg">Add New Property</h3>
              <button onClick={() => setShowListingModal(false)} className="text-slate-400 hover:text-slate-600"><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handleSaveListing} className="p-6 space-y-4">
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-1">Listing Name</label>
                <input required type="text" value={listingForm.name} onChange={e => setListingForm({...listingForm, name: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="e.g. Villa Bali" />
              </div>
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-1">Airbnb iCal URL</label>
                <input type="url" value={listingForm.airbnbUrl} onChange={e => setListingForm({...listingForm, airbnbUrl: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="https://www.airbnb.com/calendar/ical/..." />
              </div>
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-1">Booking.com iCal URL</label>
                <input type="url" value={listingForm.bookingUrl} onChange={e => setListingForm({...listingForm, bookingUrl: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 outline-none text-sm" placeholder="https://ical.booking.com/v1/export..." />
              </div>
              <div className="pt-4 flex justify-end space-x-3">
                <button type="button" onClick={() => setShowListingModal(false)} className="px-4 py-2 text-slate-600 font-medium hover:bg-slate-100 rounded-lg">Cancel</button>
                <button type="submit" className="px-4 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 flex items-center">
                  <Save className="w-4 h-4 mr-2" /> Save Property
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Add Manual Booking Modal */}
      {showBookingModal && (
        <div className="fixed inset-0 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
            <div className="p-4 border-b border-slate-200 flex justify-between items-center">
              <h3 className="font-bold text-lg">Add Manual Booking</h3>
              <button onClick={() => setShowBookingModal(false)} className="text-slate-400 hover:text-slate-600"><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handleSaveBooking} className="p-6 space-y-4">
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-1">Platform / Source</label>
                <select value={bookingForm.platform} onChange={e => setBookingForm({...bookingForm, platform: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2.5 outline-none bg-white">
                  <option value="Direct">Direct Booking</option>
                  <option value="Airbnb">Airbnb (Manual)</option>
                  <option value="Booking.com">Booking.com (Manual)</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label className="block text-sm font-medium text-slate-700 mb-1">Guest Name</label>
                <input required type="text" value={bookingForm.guestName} onChange={e => setBookingForm({...bookingForm, guestName: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2.5 outline-none" placeholder="John Doe" />
              </div>
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-1">Check-in</label>
                  <input required type="date" value={bookingForm.start} onChange={e => setBookingForm({...bookingForm, start: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2 outline-none text-sm" />
                </div>
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-1">Check-out</label>
                  <input required type="date" value={bookingForm.end} onChange={e => setBookingForm({...bookingForm, end: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2 outline-none text-sm" />
                </div>
              </div>
              <div className="grid grid-cols-2 gap-4 items-center">
                <div>
                  <label className="block text-sm font-medium text-slate-700 mb-1">Total Guests</label>
                  <input required type="number" min="1" value={bookingForm.guests} onChange={e => setBookingForm({...bookingForm, guests: e.target.value})} className="w-full border border-slate-300 rounded-lg p-2 outline-none" />
                </div>
                <div className="flex items-center h-full pt-6">
                  <label className="flex items-center space-x-2 cursor-pointer">
                    <input type="checkbox" checked={bookingForm.extraBed} onChange={e => setBookingForm({...bookingForm, extraBed: e.target.checked})} className="w-5 h-5 text-indigo-600 rounded border-slate-300" />
                    <span className="text-sm font-medium text-slate-700">Needs Extra Bed</span>
                  </label>
                </div>
              </div>
              <div className="pt-4 flex justify-end space-x-3">
                <button type="button" onClick={() => setShowBookingModal(false)} className="px-4 py-2 text-slate-600 font-medium hover:bg-slate-100 rounded-lg">Cancel</button>
                <button type="submit" className="px-4 py-2 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 flex items-center">
                  <Save className="w-4 h-4 mr-2" /> Save Booking
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}
